# Configuration for the mcp-timeline launchd services.
#
# install-macos.sh copies this to mcp-timeline.env on first run and fills in
# a freshly generated OWNTRACKS_TOKEN. Edit that copy, not this sample.
# mcp-timeline.env holds a secret and is gitignored; keep it that way.

# Required. The public hostname your tunnel serves the MCP server on.
# Without it the SDK's DNS-rebinding protection rejects tunneled requests
# with "421 Invalid Host header", since it only trusts localhost by default.
MCP_PUBLIC_HOST=timeline.example.com

# Shared secret the OwnTracks app sends as "Authorization: Bearer <token>".
# Generated automatically on first run; replace only if you rotate it.
OWNTRACKS_TOKEN=

# Shared secret for the Apple Health capture endpoint, sent the same way by
# whatever posts health data (a Shortcuts automation, for example). Separate
# from the OwnTracks secret on purpose: rotating or leaking one should not
# affect the other. Also generated automatically on first run.
WEBHOOK_TOKEN=

# Reverse geocoding: turns coordinates into place names for stays the
# database does not already know, which is what makes a day in an
# unfamiliar city readable. OFF unless set, because it sends those
# coordinates to OpenStreetMap's Nominatim service. Only stays are ever
# sent, never the full trail, and each one is looked up once and cached.
# Set to 1 to enable.
GEOCODE_ENABLED=

# Optional. Defaults shown.
#TIMELINE_DB=/absolute/path/to/timeline.db
#VENV_PYTHON=/absolute/path/to/.venv/bin/python
#MCP_PORT=8000
#OWNTRACKS_PORT=8002
#HEALTH_PORT=8001
#WEBHOOK_CAPTURE_DIR=/absolute/path/to/captures

# Location fixes less accurate than this many meters are dropped rather
# than stored. A several-hundred-meter fix invents movement that never
# happened, which is worse than having no point at all.
#OWNTRACKS_MAX_ACCURACY_M=500
